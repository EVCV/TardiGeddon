# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Legal pages stay out of search results. Don't block them in robots.txt
# instead: crawlers have to fetch a page to see its noindex.
/legal/*
  X-Robots-Tag: noindex, follow

# The game's service worker (offline play) must always be checked for a new
# version, or players could be stuck on an old game.
/play/sw.js
  Cache-Control: no-cache

# The news (src/news/news.ts): the phone apps fetch it from here (their pages
# aren't on tardigeddon.com), so any site may read it. Public, and checked
# for changes each time, so new posts show at once.
/news.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

# App links (src/apps.ts): Apple and Google read these to let the apps open
# tardigeddon.com/play links. They must be JSON, and not wait in a cache long.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: max-age=3600

# Security headers for every page, the game at /play/ included.
# - CSP: only our own scripts (plus Cloudflare's analytics beacon), no inline
#   scripts or eval, connections only to us and the game server, and nobody may
#   put the site in a frame (no clickjacking of the shop or account pages).
#   The exceptions: the giveaway entry form (Sociamonials, app.socialmi.co.uk) on /giveaway,
#   and Cloudflare Turnstile (challenges.cloudflare.com: its script and its frame),
#   which the game loads only when a signed-in player opens the Roadmap, to check a
#   vote or an idea comes from a real player (docs/ROADMAP.md). Turnstile needs only
#   script-src and frame-src (connect-src is for its pre-clearance mode, which we don't use).
# - HSTS: browsers only ever use HTTPS for tardigeddon.com.
# Keep in step with docs/SECURITY.md when adding anything third-party.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; connect-src 'self' https://server.tardigeddon.com wss://server.tardigeddon.com https://cloudflareinsights.com; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self' https://app.socialmi.co.uk https://challenges.cloudflare.com; font-src 'self' data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
