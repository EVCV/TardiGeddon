# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# Legal pages stay out of search results. Don't block them in robots.txt
# instead: crawlers have to fetch a page to see its noindex.
/legal/*
  X-Robots-Tag: noindex, follow

# Security headers for every page, the game at /play/ included.
# - CSP: only our own scripts (plus Cloudflare's analytics beacon), no inline
#   scripts or eval, connections only to us and the game server, and nobody may
#   put the site in a frame (no clickjacking of the shop or account pages).
# - HSTS: browsers only ever use HTTPS for tardigeddon.com.
# Keep in step with docs/SECURITY.md when adding anything third-party.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://server.tardigeddon.com wss://server.tardigeddon.com https://cloudflareinsights.com; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
