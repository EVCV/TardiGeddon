# Signed builds of the iOS app for TestFlight, made on GitHub's Macs
# (.github/workflows/ios.yml, docs/IOS.md §5). Actions run from ios/; the Ruby
# here runs from ios/fastlane/.
require 'json'

default_platform(:ios)

platform :ios do
  desc 'Sign the app and upload it to TestFlight'
  lane :beta do
    setup_ci # a throwaway keychain for the certificate, on GitHub's Mac

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_KEY_P8_BASE64'),
      is_key_content_base64: true,
    )

    # Fetches the certificate and profile from the signing repo; the first time,
    # makes them (with the API key) and saves them there.
    match(api_key: api_key, readonly: false)

    # App links (tardigeddon.com/play opens the app) need Associated Domains on
    # the App ID. Switched on here with the API key, so nobody has to tick it.
    begin
      bundle = Spaceship::ConnectAPI::BundleId.find('com.tardigeddon.app')
      types = bundle.get_capabilities.map(&:capability_type)
      unless types.include?(Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS)
        UI.message('Switching on Associated Domains for the App ID (app links)')
        bundle.update_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::ASSOCIATED_DOMAINS, enabled: true)
      end
    rescue StandardError => e
      UI.important("Couldn't check the App ID's Associated Domains: #{e.message}")
    end

    # A profile made before a capability was added to the app (App.entitlements:
    # Sign in with Apple, Declared Age Range, Associated Domains) can't sign it:
    # make a new one, once. The App ID needs the capabilities ticked first (docs/IOS.md §5).
    needed = %w[com.apple.developer.applesignin com.apple.developer.declared-age-range com.apple.developer.associated-domains]
    profile = ENV.fetch('sigh_com.tardigeddon.app_appstore_profile-path')
    has = `security cms -D -i "#{profile}"`
    unless needed.all? { |e| has.include?(e) }
      UI.important('The signing profile lacks a capability in App.entitlements: making a new one')
      match(api_key: api_key, readonly: false, force: true)
      has = `security cms -D -i "#{ENV.fetch('sigh_com.tardigeddon.app_appstore_profile-path')}"`
    end
    # Still no Associated Domains (not on the App ID): build without app links
    # rather than fail; links then open the website, as before.
    unless has.include?('com.apple.developer.associated-domains')
      UI.important('No Associated Domains on the App ID: this build is without app links (docs/IOS.md §5)')
      entitlements = File.expand_path('../App/App/App.entitlements', __dir__)
      sh('/usr/libexec/PlistBuddy', '-c', 'Delete :com.apple.developer.associated-domains', entitlements)
    end

    # The version players see is package.json's; the build number goes up with
    # every run, as Apple needs a new one for each upload.
    version = JSON.parse(File.read('../../package.json'))['version']
    increment_version_number(version_number: version, xcodeproj: 'App/App.xcodeproj')
    increment_build_number(build_number: ENV.fetch('GITHUB_RUN_NUMBER'), xcodeproj: 'App/App.xcodeproj')

    update_code_signing_settings(
      path: 'App/App.xcodeproj',
      targets: ['App'],
      use_automatic_signing: false,
      team_id: ENV['sigh_com.tardigeddon.app_appstore_team-id'],
      profile_name: ENV['sigh_com.tardigeddon.app_appstore_profile-name'],
      code_sign_identity: 'Apple Distribution',
    )

    build_app(
      project: 'App/App.xcodeproj',
      scheme: 'App',
      configuration: 'Release',
      export_method: 'app-store',
      output_directory: 'build',
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
