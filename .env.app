# Settings for the phone apps' build (`npm run app:build` = `vite build --mode app`).
# The apps can't work out the game server from their own address like the website does.
VITE_SERVER_URL=wss://server.tardigeddon.com
# Where invite links point: the web game, which opens the room (or the app, once app links are set up).
VITE_WEB_URL=https://tardigeddon.com/play/
