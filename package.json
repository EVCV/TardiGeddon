{
  "name": "tardigeddon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "server": "tsx server/main.ts",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts && vite build --config site/vite.config.ts --ssr src/entry-server.tsx --outDir ../dist-ssr --emptyOutDir && node site/prerender.mjs",
    "site:preview": "vite preview --config site/vite.config.ts --port 4174",
    "build:all": "npm run build && npm run site:build && node -e \"require('fs').cpSync('dist', 'dist-site/play', { recursive: true })\"",
    "app:build": "tsc --noEmit && vite build --mode app && cap sync",
    "app:android": "cap open android",
    "app:ios": "cap open ios",
    "i18n": "tsx scripts/i18n.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "better-auth": "^1.7.7",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "marked": "^18.1.0",
    "nodemailer": "10.0.10",
    "pg": "^8.23.1",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
